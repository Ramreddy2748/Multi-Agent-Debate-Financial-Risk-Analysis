FRED_API_KEY=your_fred_api_key_here
NEWS_API_KEY=your_newsapi_key_here

FUNDAMENTAL_FINBERT_ENABLED=1
FUNDAMENTAL_FINBERT_MODEL_DIR=models/fundamental_agent_finbert

MARKET_LORA_ENABLED=1
MARKET_LORA_ADAPTER_DIR=models/market_sentiment_lora
MARKET_LORA_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
MARKET_LORA_MAX_NEW_TOKENS=48
MARKET_LORA_REMOTE_URL=
MARKET_LORA_REMOTE_TIMEOUT=600

# To use the Mistral 7B adapter after running agents/market_mistral_training.ipynb:
# MARKET_LORA_BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# MARKET_LORA_ADAPTER_DIR=models/market_mistral_lora

CRITIC_API_KEY=
CRITIC_BASE_URL=
CRITIC_MODEL=gpt-4o-mini
CRITIC_LLM_ENABLED=0

# Claude critic/orchestrator option
# Set CRITIC_LLM_ENABLED=1 and provide ANTHROPIC_API_KEY to let Claude resolve
# specialist-agent disagreements before falling back to weighted rules.
CRITIC_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
CRITIC_MAX_TOKENS=900
CRITIC_TIMEOUT_SECONDS=60
